DSR_ALMAS_OBJETIVO = 9999999
DSR_iniciar(&quot;almas&quot;, 250, function()
  local d = DSR_datosJugador()
  local dir = nil
  if d ~= nil then dir = d + 0x94 else dir = DSR_leerManual(&quot;Mis Almas (manual)&quot;) end
  if dir ~= nil then
    local actual = readInteger(dir)
    if actual ~= nil and DSR_ALMAS_OBJETIVO &gt; actual then
      writeInteger(dir, DSR_ALMAS_OBJETIVO)
    end
  end
end)

