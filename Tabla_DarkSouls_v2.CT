      <CheatEntries>
        <CheatEntry>
          <ID>5</ID>
          <Description>&quot;0) ACTIVAR PRIMERO: Inicializar (buscar punteros)&quot;</Description>
          <LastState/>
          <Color>0000FF</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>
[ENABLE]
{$lua}
if syntaxcheck then return end

-- Busca una instruccion &quot;mov rax,[rip+XX]&quot; y devuelve la direccion a la que apunta
local function buscarPunteroRip(aob)
  local res = AOBScan(aob, &quot;+X-C&quot;)
  if res == nil then return nil end
  if res.Count == 0 then res.destroy() return nil end
  local lista = {}
  for i = 0, res.Count - 1 do
    local addr = tonumber(res[i], 16)
    local disp = readInteger(addr + 3)
    if disp ~= nil then
      if disp &gt; 0x7FFFFFFF then disp = disp - 0x100000000 end
      lista[#lista + 1] = addr + 7 + disp
    end
  end
  res.destroy()
  return lista
end

local function hpValido(ptr)
  local base = readQword(ptr)
  if base == nil or base == 0 then return false end
  local jugador = readQword(base + 0x68)
  if jugador == nil or jugador == 0 then return false end
  local hp = readInteger(jugador + 0x3E8)
  local hpMax = readInteger(jugador + 0x3EC)
  if hp == nil or hpMax == nil then return false end
  return hpMax &gt; 0 and hpMax &lt; 10000 and hp &gt;= 0 and not (hp &gt; hpMax)
end

local function almasValidas(ptr)
  local base = readQword(ptr)
  if base == nil or base == 0 then return false end
  local datos = readQword(base + 0x10)
  if datos == nil or datos == 0 then return false end
  local almas = readInteger(datos + 0x94)
  return almas ~= nil and almas &gt;= 0 and not (almas &gt; 999999999)
end

local aobsWorldChrMan = {
  &quot;48 8B 05 ?? ?? ?? ?? 48 8B 48 68 48 85 C9 0F 84 ?? ?? ?? ?? 48 39 5E 10 0F 84 ?? ?? ?? ?? 48&quot;,
  &quot;48 8B 05 ?? ?? ?? ?? 48 39 48 68 0F 94 C0 C3&quot;,
}
local aobsGameDataMan = {
  &quot;48 8B 05 ?? ?? ?? ?? 45 33 ED 48 8B F1 48 85 C0&quot;,
  &quot;48 8B 05 ?? ?? ?? ?? 48 8B 40 10 48 85 C0&quot;,
}

local function encontrar(aobs, validar)
  for _, aob in ipairs(aobs) do
    local lista = buscarPunteroRip(aob)
    if lista ~= nil then
      for _, p in ipairs(lista) do
        if validar(p) then return p end
      end
    end
  end
  return nil
end

local wcm = encontrar(aobsWorldChrMan, hpValido)
local gdm = encontrar(aobsGameDataMan, almasValidas)

local msg = &quot;&quot;
if wcm ~= nil then
  unregisterSymbol(&quot;WorldChrMan&quot;)
  registerSymbol(&quot;WorldChrMan&quot;, wcm, true)
  msg = msg .. &quot;WorldChrMan encontrado (Vida / Estamina): OK\n&quot;
else
  msg = msg .. &quot;WorldChrMan NO encontrado. Usa las direcciones manuales de Vida y Estamina.\n&quot;
end
if gdm ~= nil then
  unregisterSymbol(&quot;GameDataMan&quot;)
  registerSymbol(&quot;GameDataMan&quot;, gdm, true)
  msg = msg .. &quot;GameDataMan encontrado (Almas): OK\n&quot;
else
  msg = msg .. &quot;GameDataMan NO encontrado. Usa la direccion manual de Almas.\n&quot;
end
print(msg)
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
unregisterSymbol(&quot;WorldChrMan&quot;)
unregisterSymbol(&quot;GameDataMan&quot;)
{$asm}
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>6</ID>
          <Description>&quot;Vida Infinita  [F1]&quot;</Description>
          <LastState/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end

function DSR_leerManual(descripcion)
  local mr = getAddressList().getMemoryRecordByDescription(descripcion)
  if mr == nil then return nil end
  local a = mr.CurrentAddress
  if a == nil or a == 0 then return nil end
  return a
end

function DSR_jugador()
  local ok, wcm = pcall(getAddress, &quot;WorldChrMan&quot;)
  if not ok or wcm == nil or wcm == 0 then return nil end
  local base = readQword(wcm)
  if base == nil or base == 0 then return nil end
  local jugador = readQword(base + 0x68)
  if jugador == nil or jugador == 0 then return nil end
  return jugador
end

function DSR_datosJugador()
  local ok, gdm = pcall(getAddress, &quot;GameDataMan&quot;)
  if not ok or gdm == nil or gdm == 0 then return nil end
  local base = readQword(gdm)
  if base == nil or base == 0 then return nil end
  local datos = readQword(base + 0x10)
  if datos == nil or datos == 0 then return nil end
  return datos
end

DSR_timers = DSR_timers or {}

function DSR_iniciar(nombre, intervalo, funcion)
  DSR_detener(nombre)
  local t = createTimer(nil, false)
  t.Interval = intervalo
  t.OnTimer = function() pcall(funcion) end
  t.Enabled = true
  DSR_timers[nombre] = t
end

function DSR_detener(nombre)
  if DSR_timers[nombre] ~= nil then
    DSR_timers[nombre].destroy()
    DSR_timers[nombre] = nil
  end
end

DSR_iniciar(&quot;vida&quot;, 100, function()
  local j = DSR_jugador()
  if j ~= nil then
    local hpMax = readInteger(j + 0x3EC)
    if hpMax ~= nil and hpMax &gt; 0 then writeInteger(j + 0x3E8, hpMax) end
    return
  end
  local hp = DSR_leerManual(&quot;Mi HP (manual)&quot;)
  local hpMax = DSR_leerManual(&quot;Mi HP Max (manual)&quot;)
  if hp ~= nil and hpMax ~= nil then
    writeInteger(hp, readInteger(hpMax))
  elseif hp ~= nil then
    writeInteger(hp, 9999)
  end
end)

{$asm}

